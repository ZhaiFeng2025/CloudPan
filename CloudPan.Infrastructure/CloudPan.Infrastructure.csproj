<Project Sdk="Microsoft.NET.Sdk">

  <!-- 基础设施层：两端共用（持久化/存储/安全）。依赖方向：→ Contract；被 Core/Host/UI 引用。 -->
  <PropertyGroup>
    <!-- net8.0-windows：SecretStore 使用 Windows ACL（FileSystemAccessRule）；产品 Windows-only -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- T-079：ThemeWatcher（Infrastructure/Design）下沉后两端共用，依赖 Form/Control 等 WinForms 类型；
         WindowsDesktop 框架随之提供 System.Drawing 与 Microsoft.Win32.SystemEvents，下方显式包引用移除 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudPan.Contract\CloudPan.Contract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- T-096：日志工厂（SerilogFactory）宿主；版本由 Directory.Build.props 单源化 -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
    <PackageReference Include="Serilog" Version="$(SerilogVersion)" />
    <PackageReference Include="Serilog.Sinks.Console" Version="$(SerilogSinksConsoleVersion)" />
    <PackageReference Include="Serilog.Sinks.File" Version="$(SerilogSinksFileVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.22" />
    <!-- SQLite 原生库：自包含单文件发布必需，解决 DllNotFoundException -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
    <!-- 设计时支持：dotnet ef migrations（含设计时工厂，PrivateAssets 不流向消费者） -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.22">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
