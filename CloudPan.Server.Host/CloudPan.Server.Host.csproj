<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- 服务端宿主：HTTP 适配 + 中间件 + IHostedService 定时任务 + 薄组合根。依赖方向：→ UI/Core/Infrastructure/Contract。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- 发布产物保持 CloudPan.Server.exe（安装脚本/文档引用该名） -->
    <AssemblyName>CloudPan.Server</AssemblyName>
    <!-- 自包含单文件发布：嵌入原生 DLL（SQLite 等） -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudPan.Contract\CloudPan.Contract.csproj" />
    <ProjectReference Include="..\CloudPan.Infrastructure\CloudPan.Infrastructure.csproj" />
    <ProjectReference Include="..\CloudPan.Server.Core\CloudPan.Server.Core.csproj" />
    <!-- T-015：不再编译期引用可选 UI 模块（headless 可编译）。可选 UI 经 IHostUIBridge 运行期反射接入 -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.22" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.22">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!-- 版本由 Directory.Build.props 单源化（T-096） -->
    <PackageReference Include="Serilog.AspNetCore" Version="$(SerilogAspNetCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CloudPan.Tests" />
  </ItemGroup>

</Project>
