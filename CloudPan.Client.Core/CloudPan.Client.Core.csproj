<Project Sdk="Microsoft.NET.Sdk">

  <!-- 客户端领域层：同步状态机/队列/传输客户端。持久化（ClientDbContext/迁移/实体）已下沉 Infrastructure/Persistence（T-068），领域层仅经 IDbContextFactory 使用。依赖方向：→ Infrastructure/Contract；不引用 WinForms（R-A2）。 -->
  <PropertyGroup>
    <!-- net8.0-windows：SettingsStore 使用 DPAPI（ProtectedData） -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudPan.Contract\CloudPan.Contract.csproj" />
    <ProjectReference Include="..\CloudPan.Infrastructure\CloudPan.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.22" />
    <!-- SQLite 原生库：自包含单文件发布必需，解决 DllNotFoundException -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
    <!-- 设计时支持：dotnet ef migrations（含设计时工厂，PrivateAssets 不流向消费者） -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.22">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <!-- 日志（组合根 T-029：Serilog 初始化与 AddSerilog 下沉 Client.Core，UI 壳不再承载） -->
    <PackageReference Include="Serilog" Version="4.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- DPAPI（组合根 T-029：Token 加解密下沉 Client.Core；非 WinForms 项目需显式包引用） -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
