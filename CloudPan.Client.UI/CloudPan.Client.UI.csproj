<Project Sdk="Microsoft.NET.Sdk">

  <!-- 客户端 WinForms 壳：只做渲染与交互，业务逻辑在 Client.Core。依赖方向：→ Client.Core/Infrastructure/Contract。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- 发布产物保持 CloudPan.Client.exe（安装脚本/文档引用该名） -->
    <AssemblyName>CloudPan.Client</AssemblyName>
    <!-- 自包含单文件发布：嵌入原生 DLL（SQLite 等） -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudPan.Contract\CloudPan.Contract.csproj" />
    <ProjectReference Include="..\CloudPan.Infrastructure\CloudPan.Infrastructure.csproj" />
    <ProjectReference Include="..\CloudPan.Client.Core\CloudPan.Client.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- T-075：供 CloudPan.Tests 直接测试内部同步根路径安全校验 -->
    <InternalsVisibleTo Include="CloudPan.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF/SQLite/Serilog 由 Client.Core 承载（T-029 组合根下沉），UI 壳只渲染 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

</Project>
