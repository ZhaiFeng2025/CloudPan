<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- T-096：CentralPackageVersions（Serilog 系列版本单一来源）——消除 Client.Core 4.0.0 vs Server.UI 4.3.0 漂移。
       各 csproj 经 $(Serilog*Version) 引用，改版本只改此处。注：NuGet CPM 为全仓库启用（会强制集中全部包），
       本任务仅统一 Serilog 系列，故用 MSBuild 属性常量单源化（与 CPM 等价的效果、零侵入）。 -->
  <PropertyGroup>
    <SerilogVersion>4.4.0</SerilogVersion>
    <SerilogAspNetCoreVersion>8.0.3</SerilogAspNetCoreVersion>
    <SerilogExtensionsLoggingVersion>8.0.0</SerilogExtensionsLoggingVersion>
    <SerilogSinksConsoleVersion>6.0.0</SerilogSinksConsoleVersion>
    <SerilogSinksFileVersion>6.0.0</SerilogSinksFileVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'CloudPan.CodeGen' and '$(MSBuildProjectName)' != 'CloudPan.Analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)CloudPan.Analyzers/CloudPan.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)shared-spec.json" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CP301（匿名lambda订阅）和CP200（敏感数据写盘）在UI代码中大量使用，v1.0暂不阻塞Relase编译 -->
    <!-- CP303（IDisposable未持有）为性能建议，不阻塞Release -->
    <WarningsNotAsErrors>CP301;CP200;CP303</WarningsNotAsErrors>
  </PropertyGroup>
  <PropertyGroup>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- 覆盖率目标（CloudPan.Tests）：dotnet test /p:CollectCoverage=true /p:CoverletOutputFormat=cobertura /p:CoverletOutput=TestResults/coverage/ -->
  <!-- 输出：TestResults/coverage/*.cobertura.xml 与 *.json，可用 ReportGenerator 汇总 -->
</Project>
