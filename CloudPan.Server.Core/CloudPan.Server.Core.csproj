<Project Sdk="Microsoft.NET.Sdk">

  <!-- 服务端领域层：索引/版本/日志/WebSocket 处理。依赖方向：→ Infrastructure → Contract；不引用 ASP.NET（R-A2）。 -->
  <PropertyGroup>
    <!-- net8.0-windows：引用 Infrastructure（net8.0-windows）所需 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudPan.Contract\CloudPan.Contract.csproj" />
    <ProjectReference Include="..\CloudPan.Infrastructure\CloudPan.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- T-111：WebSocketSession 三阶段（认证/接收循环/断连清理）单测需访问 internal 协作类（与 Client.UI/Server.Host 同款模式） -->
    <InternalsVisibleTo Include="CloudPan.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 版本对齐 EF Core 8.0.22 传递依赖（8.0.1/8.0.2），避免 NU1605 降级 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <!-- WebSocket 心跳托管服务（T-057 WebSocketHeartbeatHostedService）用 BackgroundService/IHostedService -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <!-- 缩略图生成（ThumbnailService 使用，与 Host 端版本对齐） -->
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
  </ItemGroup>

</Project>
